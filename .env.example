NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/movie_recommendation

REDIS_URL=redis://localhost:6379

RABBITMQ_URL=amqp://guest:guest@localhost:5672

# TMDB v3 API key or v4 read access token
TMDB_API_KEY=

GROQ_API_KEY=

# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional (defaults shown)
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_LANGUAGE=es-ES
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_RATE_LIMIT_PER_MINUTE=30
# RECOMMENDATION_MAX_ATTEMPTS=3
# RECOMMENDATION_MAX_WAIT_MINUTES=30
# AUTH_RATE_LIMIT_PER_MINUTE=10
